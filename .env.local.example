# Copy this file to .env.local and fill in the DEVELOPMENT project's values.
# Local development must use the dev database, never production.
#
# There is no fallback: if any of these is missing the app refuses to start,
# and if APP_ENV doesn't match the project the URL points at, it also refuses.

# 'development' for local + preview, 'production' only on the live deployment.
NEXT_PUBLIC_APP_ENV=development

# Dev project — Supabase dashboard (adex-mission-control-dev) → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ficmtwvmmcsxxexhysbd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key-here
